# Gemma / LLM Configuration
# Read ONLY from GEMMA_API_KEY. Leave blank or mock if testing offline.
GEMMA_API_KEY=your_api_key_here
GEMMA_MODEL=gemma-3-27b-it
# Optional custom base URL for OpenAI-compatible endpoints or Ollama (default: Google AI Studio endpoint or OpenAI-compatible endpoint)
LLM_BASE_URL=
PORT=8000
HOST=0.0.0.0


GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Set true when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false